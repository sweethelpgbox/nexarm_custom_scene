<?xml version="1.0" encoding="utf-8"?>
<robot name="NexArm" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="prefix" default=""/>
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0038665 2.0154E-06 0.026241"/>
      <mass value="0.184970476929002"/>
      <inertia ixx="0.00011436" ixy="-2.127E-09" ixz="2.2436E-06" iyy="9.1966E-05" iyz="3.0965E-09" izz="0.00017896"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>
  <link name="link1">
    <inertial>
      <origin rpy="0 0 0" xyz="5.6716152818298E-05 -1.86344172289354E-05 0.00418728087306319"/>
      <mass value="0.0920484315594834"/>
      <inertia ixx="4.05599543416967E-05" ixy="1.65185188703231E-09" ixz="2.44704004347051E-08" iyy="3.90268860828527E-05" iyz="1.63055586039366E-08" izz="6.80315119700401E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/link1.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/link1.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin rpy="0 0 0" xyz="0.00042383 0 0.071003"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 -1"/>
    <limit effort="1000" lower="-2.09" upper="2.09" velocity="3.14"/>
  </joint>
  <link name="link2">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0010467043709268 -0.0373060906216532 0.117940336564004"/>
      <mass value="0.0590642381074413"/>
      <inertia ixx="0.000126365190348819" ixy="-2.04852919617321E-11" ixz="6.46183559143708E-07" iyy="0.000122570999972299" iyz="-2.23011604572762E-12" izz="1.13949066313735E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/link2.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/link2.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin rpy="0 0 0" xyz="-0.00041844 0.03728 0.039446"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-1.57" upper="1.0" velocity="3.14"/>
  </joint>
  <link name="link3">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0137516433678302 -0.0196288133010798 -0.0711816402502082"/>
      <mass value="0.062815962862313"/>
      <inertia ixx="1.41867477534541E-05" ixy="5.59159372224557E-09" ixz="1.6737868665363E-06" iyy="1.59862374357988E-05" iyz="1.07176241107346E-09" izz="5.78320845698204E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/link3.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/link3.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin rpy="0 0 0" xyz="0.0348 -0.01893 0.22535"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-3.14" upper="0.3" velocity="3.14"/>
  </joint>
  <link name="link4">
    <inertial>
      <origin rpy="0 0 0" xyz="0.024201 -0.018501 -0.004772"/>
      <mass value="0.014717"/>
      <inertia ixx="4.033E-06" ixy="-4.9295E-09" ixz="1.8768E-07" iyy="3.1677E-06" iyz="-6.8295E-09" izz="4.2652E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/link4.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/link4.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin rpy="0 0 0" xyz="0.027316 0 -0.14239"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-0.66" upper="1.57" velocity="3.14"/>
  </joint>
  <link name="camera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.012569 0.00066394 -0.00080194"/>
      <mass value="0.011861"/>
      <inertia ixx="6.7349E-06" ixy="6.6894E-09" ixz="-5.2096E-09" iyy="8.4701E-07" iyz="3.4214E-10" izz="6.2448E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/camera_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/camera_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.064555 -0.019407 0.036497"/>
    <parent link="link4"/>
    <child link="camera_link"/>
    <axis xyz="0 0 0"/>
  </joint>
  <link name="link5">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00198440314474035 -1.03724012712192E-08 1.19814488730163E-05"/>
      <mass value="0.00101780721058781"/>
      <inertia ixx="4.40367355590698E-08" ixy="-6.22255583580631E-14" ixz="-1.23825869712916E-10" iyy="2.35859027398144E-08" iyz="6.53467724851782E-13" izz="2.35874457790837E-08"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/link5.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/link5.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin rpy="0 0 0" xyz="0.049832 -0.018351 -0.00031098"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0.99998 0 -0.0060546"/>
    <limit effort="10.0" lower="-2.09" upper="2.09" velocity="3.14"/>
  </joint>
  
  <link name="gripper_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0093418045032847 -3.34240037377365E-05 -0.00222341566035766"/>
      <mass value="0.0200924941074607"/>
      <inertia ixx="1.44654482810758E-05" ixy="-4.85748537654977E-09" ixz="3.08608213029111E-09" iyy="2.40766161157147E-06" iyz="-6.9176574076478E-09" izz="1.33196687098113E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/gripper_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/gripper_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.035032 0 -0.00022027"/>
    <parent link="link5"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 0"/>
    <limit effort="0" lower="0" upper="0" velocity="3.14"/>
  </joint>
  <link name="gripper_base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0019703 9.9566E-10 1.3103E-05"/>
      <mass value="0.0010359"/>
      <inertia ixx="4.7289E-08" ixy="3.4822E-15" ixz="-1.4599E-10" iyy="2.5339E-08" iyz="2.281E-15" izz="2.534E-08"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/gripper_base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/gripper_base_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper_base_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.0023084 0 -1.4336E-05"/>
    <parent link="gripper_link"/>
    <child link="gripper_base_link"/>
    <axis xyz="0.99998 0 -0.0066507"/>
    <limit effort="0" lower="0" upper="0.5" velocity="3.14"/>
  </joint>
  <link name="right_jaw_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.011947 0.0031957 0.012657"/>
      <mass value="0.014194"/>
      <inertia ixx="1.4275E-06" ixy="-8.4648E-08" ixz="-1.4624E-08" iyy="1.5892E-06" iyz="1.6325E-09" izz="1.3101E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/right_jaw_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/right_jaw_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_jaw_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0.0081154 -0.038561 -0.013453"/>
    <parent link="gripper_link"/>
    <child link="right_jaw_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" lower="0" upper="0" velocity="3.14"/>
    <mimic joint="gripper_base_joint" multiplier="0.05" offset="0" />
  </joint>
  <link name="left_jaw_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.010954 -0.0031957 0.013987"/>
      <mass value="0.014194"/>
      <inertia ixx="1.4279E-06" ixy="8.4662E-08" ixz="1.3039E-08" iyy="1.5892E-06" iyz="5.0959E-10" izz="1.3098E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/left_jaw_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find nexarm_description)/meshes/left_jaw_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_jaw_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0.0091166 0.038561 -0.01346"/>
    <parent link="gripper_link"/>
    <child link="left_jaw_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" lower="0" upper="0" velocity="3.14"/>
    <mimic joint="gripper_base_joint" multiplier="-0.05" offset="0" />
  </joint>
  
  <!-- Import jetarm ros_control description -->
  <xacro:include filename="$(find nexarm_description)/urdf/nexarm.gazebo.xacro" /> 
  <xacro:include filename="$(find nexarm_description)/urdf/nexarm.transmission.xacro"/>
  
  <!-- Used for fixing robot -->
  <link name="world"/>
  <gazebo reference="world">
     <static>true</static>
  </gazebo>

  <!-- 2. world → base_link 固定连接 -->
  <joint name="world_to_base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>  <!-- 与宏中的origin相同 -->
  </joint>
   
  <xacro:nexarm_gazebo prefix="$(arg prefix)"></xacro:nexarm_gazebo> 
  
  
  
</robot>
