<?xml version='1.0' encoding='utf-8'?>
<robot name="nexarm_from_step">
  <!-- Generated from STEP as one visual/collision link. -->
  <!-- Add articulated joints manually after splitting the CAD into per-link meshes. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://model_00_description/meshes/00_full.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="nexarm_light">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://model_00_description/meshes/00_full.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
</robot>
